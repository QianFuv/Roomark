<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="roomark.exe"
        Arguments=""
        InstallLocation="C:\Program Files\Roomark\Roomark">
    </Installer>
    <PackageInformation
        PackageName="Roomark"
        PackageDisplayName="Roomark"
        PublisherName="CN=Roomark"
        PublisherDisplayName="Roomark"
        Version="0.1.0.0"
        PackageDescription="Meeting room booking">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.roomark.app"
                Description="Meeting room booking"
                DisplayName="Roomark"
                ExecutableName="roomark.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Roomark</DisplayName>
            <PublisherDisplayName>Roomark</PublisherDisplayName>
            <Description>Meeting room booking</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="roomark.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
